# Salin file ini menjadi ".env" lalu isi kuncinya. File .env tidak ikut diunggah ke GitHub.
GEMINI_API_KEY=isi_kunci_gemini_di_sini

# Video latar gratis (opsional). Cukup isi salah satu. Pexels sedang tidak menerima key baru,
# jadi pakai Pixabay: daftar di pixabay.com, lalu key muncul di pixabay.com/api/docs setelah login.
# PIXABAY_API_KEY=isi_kunci_pixabay_di_sini
# PEXELS_API_KEY=isi_kunci_pexels_di_sini

# Pengaturan opsional (hapus tanda # kalau mau mengubah)
# GEMINI_MODEL=gemini-3.8-flash
# VOICE=id-ID-ArdiNeural
# VOICE_RATE=+15%
# YOUTUBE_PRIVACY=private

# Salin file ini menjadi ".env" lalu isi kuncinya. File .env tidak ikut diunggah ke GitHub.
GEMINI_API_KEY=isi_kunci_gemini_di_sini   # boleh 2-3 kunci dipisah koma: kunci1,kunci2,kunci3

# Cadangan gratis kalau Gemini sedang sibuk (opsional, tapi disarankan). Isi salah satu atau keduanya.
# Groq: console.groq.com -> API Keys. Cerebras: cloud.cerebras.ai
# GROQ_API_KEY=isi_kunci_groq_di_sini   # boleh 2 kunci dipisah koma
# CEREBRAS_API_KEY=isi_kunci_cerebras_di_sini

# Video latar gratis (opsional). Cukup isi salah satu. Pexels sedang tidak menerima key baru,
# jadi pakai Pixabay: daftar di pixabay.com, lalu key muncul di pixabay.com/api/docs setelah login.
# PIXABAY_API_KEY=isi_kunci_pixabay_di_sini
# PEXELS_API_KEY=isi_kunci_pexels_di_sini

# Pengaturan opsional (hapus tanda # kalau mau mengubah)
# GEMINI_MODEL=gemini-3.8-flash
# VOICE=id-ID-ArdiNeural
# VOICE_RATE=+15%
# YOUTUBE_PRIVACY=private
# SFX=off
# DIALOG=on
# TTS=edge
# GEMINI_VOICE=Puck
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# BGM=off
# VOICE_SHELA=id-ID-GadisNeural
# VOICE_FLAY=id-ID-ArdiNeural
# TRIM_BREATH=off
# EDITOR=off

# Animasi 3D: GL_MODE=angle (bawaan). Kalau render 3D bermasalah di komputermu, coba GL_MODE=swangle atau GL_MODE=egl.
# GL_MODE=angle
# Ilustrasi AI untuk adegan animasi: ART=off untuk mematikan.
# ART=on

# Model 3D gratis (hewan, orang, kendaraan, mesin) dari Poly Pizza.
# Daftar gratis di https://poly.pizza, lalu buat kunci di Settings > API. Tanpa ini dipakai gambar kartun 3D AI.
POLYPIZZA_KEY=
# MODEL3D=off   (matikan model 3D)

# Foto asli dari Wikimedia Commons untuk adegan kisah nyata: PHOTO=off untuk mematikan.
# PHOTO=on
# Penyamaan keras suara akhir: LOUDNORM=off untuk mematikan.
# LOUDNORM=on

# Aset luar (gambar kartun AI, foto, stok video, model unduhan). Bawaan: off
#ASET_LUAR=off
# Izinkan lanjut tanpa tahap Editor (tidak disarankan)
#ALLOW_UNEDITED=off

# Cadangan terakhir penulis kanvas. Tanpa key ini OpenRouter dilewati.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Pipeline hybrid: Gemini Image memakai seluruh key dalam GEMINI_API_KEY. Pilih model yang tersedia di akun.
# IMAGE_MODEL=gemini-3.1-flash-image
# VISION_MODEL=gemini-3.8-flash
# Opsional: fallback FLUX.1-schnell dari Hugging Face (token dengan akses Inference Providers)
# HF_TOKEN=
# Override model dari Hugging Face Inference Providers (provider dipilih otomatis)
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Lewati hanya generator gambar Gemini, bukan Gemini Vision
# SKIP_GEMINI_IMAGE=1
# Bila keduanya terisi, Cloudflare Workers AI dicoba pertama
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

# Salin file ini menjadi ".env" lalu isi kuncinya. File .env tidak ikut diunggah ke GitHub.
GEMINI_API_KEY=isi_kunci_gemini_di_sini

# Cadangan gratis kalau Gemini sedang sibuk (opsional, tapi disarankan). Isi salah satu atau keduanya.
# Groq: console.groq.com -> API Keys. Cerebras: cloud.cerebras.ai
# GROQ_API_KEY=isi_kunci_groq_di_sini
# CEREBRAS_API_KEY=isi_kunci_cerebras_di_sini

# Video latar gratis (opsional). Cukup isi salah satu. Pexels sedang tidak menerima key baru,
# jadi pakai Pixabay: daftar di pixabay.com, lalu key muncul di pixabay.com/api/docs setelah login.
# PIXABAY_API_KEY=isi_kunci_pixabay_di_sini
# PEXELS_API_KEY=isi_kunci_pexels_di_sini

# Pengaturan opsional (hapus tanda # kalau mau mengubah)
# GEMINI_MODEL=gemini-3.8-flash
# VOICE=id-ID-ArdiNeural
# VOICE_RATE=+15%
# YOUTUBE_PRIVACY=private
# SFX=off
# DIALOG=on
# TTS=edge
# GEMINI_VOICE=Puck
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# BGM=off
# VOICE_SHELA=id-ID-GadisNeural
# VOICE_FLAY=id-ID-ArdiNeural
# TRIM_BREATH=off
# EDITOR=off

# Animasi 3D: GL_MODE=angle (bawaan). Kalau render 3D bermasalah di komputermu, coba GL_MODE=swangle atau GL_MODE=egl.
# GL_MODE=angle
# Ilustrasi AI untuk adegan animasi: ART=off untuk mematikan.
# ART=on

# Model 3D gratis (hewan, orang, kendaraan, mesin) dari Poly Pizza.
# Daftar gratis di https://poly.pizza, lalu buat kunci di Settings > API. Tanpa ini dipakai gambar kartun 3D AI.
POLYPIZZA_KEY=
# MODEL3D=off   (matikan model 3D)
